<?xml version="1.0" encoding="utf-8"?>
<!-- web.config configuration for IIS Server -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
                <clear />
                <add value="index.php" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <!-- Prevent viewing sensitive directories directly -->
        <hiddenSegments>
          <add segment="config" />
          <add segment="database" />
          <add segment=".git" />
          <add segment=".planning" />
          <add segment=".claude" />
          <add segment="SDGs" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".json" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
